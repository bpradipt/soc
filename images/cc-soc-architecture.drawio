<mxfile>
  <diagram name="SoC with confidential computing" id="ccsoc">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="0" gridSize="10" guides="1" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="die" value="SoC die" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="960" height="530" as="geometry"/>
        </mxCell>
        <mxCell id="cores" value="CPU cores" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=10;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="520" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="hv" value="&lt;b&gt;Hypervisor + host OS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;untrusted: schedules VMs and manages&lt;br&gt;memory, but can't read a CVM's pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="95" y="112" width="240" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="cvm" value="&lt;b&gt;Confidential VM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;the tenant's workload:&lt;br&gt;memory isolated and encrypted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="350" y="112" width="235" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;Interconnect&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="225" width="520" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="e_hv" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="215" y="184" as="sourcePoint"/>
            <mxPoint x="215" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_cvm" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="467" y="184" as="sourcePoint"/>
            <mxPoint x="467" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;Access check on every memory access&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;which VM owns this page? · RMP (SEV-SNP) · GPT (Arm CCA) · PMP (RISC-V)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="520" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e_bus" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="259" as="sourcePoint"/>
            <mxPoint x="340" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="enc" value="&lt;b&gt;Memory encryption engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;AES, one key per confidential VM · SEV · TDX (MKTME) · Arm CCA (MEC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="375" width="520" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e_check" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="346" as="sourcePoint"/>
            <mxPoint x="340" y="375" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="mc" value="Memory controller" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="520" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="e_enc" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="431" as="sourcePoint"/>
            <mxPoint x="340" y="460" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="sp" value="Security processor (Root of Trust)&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;its own core, ROM and fuses · boots first&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;strokeWidth=3;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="320" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="rom" value="&lt;b&gt;Boot ROM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;immutable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="655" y="130" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="fuses" value="&lt;b&gt;Fuses&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chip secret (UDS)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="805" y="126" width="140" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="kdf" value="&lt;b&gt;Key derivation + signing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;DICE keys, VM keys, attestation reports&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="655" y="195" width="290" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="spnote" value="AMD Secure Processor · Arm CCA RoT core (RSE)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="655" y="248" width="290" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="e_req" value="asks for&lt;br&gt;a report" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=none;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="160" as="sourcePoint"/>
            <mxPoint x="640" y="160" as="targetPoint"/>
            <mxPoint x="0" y="-20" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tab" value="manages the&lt;br&gt;ownership table" style="endArrow=block;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="690" y="280" as="sourcePoint"/>
            <mxPoint x="600" y="318" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="690" y="318"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_keys" value="installs per-VM keys" style="endArrow=block;html=1;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="780" y="280" as="sourcePoint"/>
            <mxPoint x="600" y="403" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="780" y="403"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="dram" value="&lt;b&gt;DRAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;off-chip: a probe or DMA&lt;br&gt;sees only ciphertext&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="240" y="640" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e_dram" value="ciphertext" style="endArrow=block;startArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="340" y="496" as="sourcePoint"/>
            <mxPoint x="340" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ver" value="&lt;b&gt;Remote verifier / key broker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;checks the report, then releases&lt;br&gt;the tenant's keys (e.g. Trustee)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="740" y="640" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e_rep" value="signed attestation report" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935" y="280" as="sourcePoint"/>
            <mxPoint x="935" y="640" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="645" y="470" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg1t" value="trusted: enforcement hardware + RoT" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="468" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="645" y="498" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg2t" value="protected: the tenant's workload" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="496" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="645" y="526" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg3t" value="untrusted: host software, off-chip" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="675" y="524" width="240" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
