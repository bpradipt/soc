<mxfile>
  <diagram name="Lab SoC with straps and JTAG" id="jtaglab">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="0" gridSize="10" guides="1" page="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="die" value="SoC die" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;fillColor=none;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="900" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="rst" value="reset" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-40" y="88" width="60" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="clk" value="clock" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="-40" y="128" width="60" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="cpu" value="&lt;b&gt;CPU&lt;/b&gt;&lt;br&gt;VexRiscv (RV32)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reset vector = 0x0000_0000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="78" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e_rst" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="24" y="98" as="sourcePoint"/>
            <mxPoint x="80" y="98" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_clk" style="endArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="24" y="138" as="sourcePoint"/>
            <mxPoint x="80" y="138" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="tap" value="&lt;b&gt;JTAG TAP&lt;/b&gt; · IDCODE 0x1D1CE0FF&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IDCODE, BYPASS: always&lt;br&gt;ADDR, MEMREAD: only when debug_en&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="78" width="230" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="The attestation lab's SoC, plus strap pins,&lt;br&gt;a DEBUG_DISABLE fuse, and a JTAG TAP&lt;br&gt;that can master the bus." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="600" y="62" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;JTAG probe&lt;/b&gt; (jtag_probe.py)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;attacker with the board in hand&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="-60" width="230" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="e_probe" value="TCK, TMS, TDI, TDO" style="endArrow=block;startArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="-4" as="sourcePoint"/>
            <mxPoint x="455" y="78" as="targetPoint"/>
            <mxPoint x="0" y="-20" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="bus" value="&lt;b&gt;Interconnect&lt;/b&gt; (Wishbone bus + address decoder)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="820" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="e_cpu" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="190" y="158" as="sourcePoint"/>
            <mxPoint x="190" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tap" value="2nd bus master" style="endArrow=block;startArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="158" as="sourcePoint"/>
            <mxPoint x="455" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="rom" value="&lt;b&gt;Boot ROM&lt;/b&gt;&lt;br&gt;0x0000_0000 · 64 KiB&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reports straps, UART boot,&lt;br&gt;then DICE as before&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="80" y="290" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sram" value="&lt;b&gt;SRAM&lt;/b&gt;&lt;br&gt;0x1000_0000 · 16 KiB&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ROM stack: UDS copy, CDI,&lt;br&gt;DeviceID key (wiped)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="275" y="290" width="160" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ram" value="&lt;b&gt;Main RAM&lt;/b&gt;&lt;br&gt;0x4000_0000 · 64 KiB&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;firmware partition: from flash,&lt;br&gt;or from the UART (uart-boot)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="290" width="170" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="csr" value="&lt;b&gt;CSR space&lt;/b&gt; · 0xF000_0000&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;peripheral registers (MMIO)&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="655" y="290" width="245" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="rot" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;Root of Trust&lt;/b&gt; · 0xF000_0800&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;• OTP: UDS + DEBUG_DISABLE fuse&lt;br&gt;• straps: latched once at reset&lt;br&gt;• debug_en = strap AND NOT fuse&lt;br&gt;• UDS reads 0 once locked,&lt;br&gt;&amp;nbsp;&amp;nbsp;and on B0 while debug_en&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=3;fontSize=13;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="670" y="335" width="215" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="uart" value="UART&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;log + protocol&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="480" width="100" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="timer" value="Timer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="480" width="100" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="e_rom" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" target="rom">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="165" y="236" as="sourcePoint"/>
            <mxPoint x="165" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_sram" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" target="sram">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="355" y="236" as="sourcePoint"/>
            <mxPoint x="355" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_ram" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" target="ram">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545" y="236" as="sourcePoint"/>
            <mxPoint x="545" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_csr" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1" target="csr">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="777" y="236" as="sourcePoint"/>
            <mxPoint x="777" y="290" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_dbg" value="debug_en (wire)" style="endArrow=block;html=1;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="885" y="370" as="sourcePoint"/>
            <mxPoint x="570" y="140" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="920" y="370"/>
              <mxPoint x="920" y="140"/>
            </Array>
            <mxPoint x="-60" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="straps" value="&lt;b&gt;Board strap resistors&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;debug, uart-boot&lt;br&gt;(--strap)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="400" width="170" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="e_straps" value="strap pins" style="endArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="980" y="432" as="sourcePoint"/>
            <mxPoint x="885" y="432" as="targetPoint"/>
            <mxPoint x="0" y="-8" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="host" value="&lt;b&gt;Host&lt;/b&gt; (jtag_soc.py)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;untrusted: relays every line,&lt;br&gt;serves UART-boot images&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="655" y="610" width="245" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_host" style="endArrow=block;startArrow=block;html=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="720" y="514" as="sourcePoint"/>
            <mxPoint x="720" y="610" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ver" value="&lt;b&gt;Verifier&lt;/b&gt; (verifier.py)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;four checks, then releases the secret&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="260" y="610" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_ver" value="nonce, evidence, secret" style="endArrow=block;startArrow=block;html=1;fontSize=11;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="640" as="sourcePoint"/>
            <mxPoint x="655" y="640" as="targetPoint"/>
            <mxPoint x="0" y="-16" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="missing" value="&lt;b&gt;Not in this lab&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;a full debug module (halt, write memory),&lt;br&gt;boundary scan, authenticated debug (§6)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;fontColor=#777777;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="430" width="250" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="426" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg1t" value="immutable, trusted by construction" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="424" width="260" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="454" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg2t" value="mutable firmware, untrusted until attested" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="452" width="260" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="482" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg4t" value="debug access, open only when debug_en" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="480" width="260" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="lg3" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="22" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="lg3t" value="untrusted: the host and anything off-chip" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="110" y="508" width="300" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
