# podman build -t soc-rot-lab .
# podman run --rm -it -v $PWD:/lab:Z -w /lab soc-rot-lab ./rot_soc.py
FROM debian:trixie

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates python3 python3-venv \
        verilator libevent-dev libjson-c-dev zlib1g-dev \
        gcc-riscv64-unknown-elf meson ninja-build \
    && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv PATH=/opt/venv/bin:$PATH
RUN python3 -m venv /opt/venv

WORKDIR /opt/litex
RUN git clone --depth 1 -b 2026.08 https://github.com/enjoy-digital/litex && \
    python3 litex/litex_setup.py --init --install --config=standard --tag=2026.08
